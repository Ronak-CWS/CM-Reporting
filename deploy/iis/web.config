<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="33554432" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <!-- IIS application alias: cm-reporting. Next is built with basePath=/cm-reporting. -->
        <!-- Proxy the whole application: Next pages, API routes, images and /_next assets. -->
        <rule name="CM Reporting Next application" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:3013/cm-reporting/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Shared ARR settings may replace Microsoft's redirect host with the public site host. -->
        <!-- Restore only CM Reporting's Microsoft authorization redirect, at this application scope. -->
        <rule name="CM Reporting Microsoft authorization redirect" stopProcessing="true">
          <match serverVariable="RESPONSE_Location" pattern="^https?://(?:automation\.collectivewaste\.ca|login\.microsoftonline\.com)/(f0a98ba2-a706-40a0-9951-cf19d9778310/oauth2/v2\.0/authorize\?.+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{UNENCODED_URL}" pattern="^/cm-reporting/api/auth/microsoft/start(?:\?.*)?$" />
            <add input="{RESPONSE_STATUS}" pattern="^303$" />
          </conditions>
          <action type="Rewrite" value="https://login.microsoftonline.com/{R:1}" />
        </rule>
      </outboundRules>
    </rewrite>
    <caching enabled="false" enableKernelCache="false" />
  </system.webServer>
</configuration>
