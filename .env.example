# Copy to .env.local for development or .env.production.local on the Windows server.
# This is a variable-name template. Never commit the real secret or a populated environment file.
CM_AUTH_MODE=microsoft
CM_PORT=3013
NEXT_PUBLIC_BASE_PATH=/cm-reporting

# Production: https://automation.collectivewaste.ca (origin only, no /cm-reporting or trailing slash).
# Local testing: http://localhost:3000, with the local Web callback registered in Entra.
CM_PUBLIC_ORIGIN=http://localhost:3000

# Company tenant supplied by IT. Use a dedicated CM Reporting app registration.
CM_ENTRA_TENANT_ID=f0a98ba2-a706-40a0-9951-cf19d9778310
# Enter the new CM Reporting client ID supplied by SmartLayer.
CM_ENTRA_CLIENT_ID=
CM_ENTRA_CLIENT_SECRET=
# Leave blank to allow all members of the configured company tenant without a custom app role.
# Set a value only if IT has explicitly created and assigned that app role.
CM_ENTRA_REQUIRED_ROLE=

# Shared driver password for /blocked-call only. No Microsoft account is needed.
# No minimum length; use at most 128 characters. Blank disables driver access.
# Driver sessions last 12 hours. See docs/driver-access.md.
CM_DRIVER_LOGIN_PASSWORD=

# Temporary password-protected guest access while Microsoft sign-in issues are resolved.
# Leave disabled normally. Keep CM_AUTH_MODE=microsoft and the Entra configuration above.
# Use a private random password (20-128 characters) and an explicit UTC expiry.
# See docs/guest-testing.md. Guest submissions use the real reports/photos/email settings.
CM_GUEST_LOGIN_ENABLED=false
CM_GUEST_LOGIN_PASSWORD=
CM_GUEST_LOGIN_EXPIRES_AT=

# Daily blocked-call digest and complaint submission notifications.
# Test from a saved blocked-call record before enabling automatic delivery.
# The server IP must be approved by IT for the no-login relay.
REPORT_EMAIL_ENABLED=false
BLOCKED_CALL_EMAIL_TIME=17:00
REPORT_EMAIL_TO=rtandon@collectivewaste.ca
REPORT_EMAIL_TEST_TO=rtandon@collectivewaste.ca
SMTP_HOST=Smtp1.shivtek.ca
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# IT-approved smtp1 relay: TLS is intentionally disabled on port 25.
SMTP_IGNORE_TLS=true
SMTP_AUTH_MODE=none
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@collectivewaste.ca
EMAIL_TEST_FROM_OPTIONS=notifications@collectivewaste.ca,no-reply@collectivewaste.ca

# Production only: an absolute persistent local-disk folder OUTSIDE the application/IIS directory.
# CM_DATA_DIR=D:\CMReportingData
# Optional override; defaults to CM_DATA_DIR\service-locations.json in production:
# CM_LOCATION_CATALOGUE_PATH=D:\CMReportingData\service-locations.json

# Only for the existing external authenticated gateway mode (CM_AUTH_MODE=proxy):
# CM_TRUSTED_PROXY_KEY=
# Local UI development without Microsoft login: CM_AUTH_MODE=development.
# Production rejects development mode; never enable it on a shared listener.
